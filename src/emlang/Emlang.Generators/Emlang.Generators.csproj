<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers run inside the compiler process: netstandard2.0, old-stable Roslyn —
         CS9057 fires only when the analyzer's Roslyn is NEWER than the compiler's,
         so old is the safe direction under a preview SDK. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <PackageId>Emlang.Generators</PackageId>
    <Description>Roslyn source generators for emlang specs: each *.em.yaml AdditionalFiles item with EmlangPrefix metadata gets its Commands/Events/Errors records, closed unions and Decider switch skeletons emitted into the compilation; projects with EmlangEmit=tests get xUnit spec tests from the spec's `tests:` GWT cases instead. NOTE: the emitted unions require LangVersion preview (C# `union` types) in the consuming project.</Description>
    <PackageTags>emlang;event-modeling;event-sourcing;source-generator;roslyn;codegen</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Pure analyzer package: nothing under lib/, everything under analyzers/dotnet/cs. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- The Emlang ProjectReference is shipped inside analyzers/, never as a NuGet dep. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- No lib/ output means the snupkg would be empty (NU5017). -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" GeneratePathProperty="true" PrivateAssets="all" />
    <ProjectReference Include="..\Emlang\Emlang.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Everything the generator needs in the compiler's analyzer load context travels
       under analyzers/dotnet/cs; Roslyn dlls themselves are never packed. -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\Emlang.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PKGYamlDotNet)\lib\netstandard2.0\YamlDotNet.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\Emlang.Generators.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Roslyn-cookbook dependency shipping for ProjectReference consumers (F5/dev inside
       this repo): every TargetPathWithTargetPlatformMoniker returned from GetTargetPath
       becomes an Analyzer item in the consuming project. -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>
  <Target Name="GetDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(PKGYamlDotNet)\lib\netstandard2.0\YamlDotNet.dll" IncludeRuntimeDependency="false" />
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)Emlang.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

</Project>
